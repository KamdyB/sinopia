# ---- Backend (local dev uses SQLite; deployments use external Postgres) ----
# DATABASE_URL=postgresql://user:password@host:port/dbname   # Tiger Cloud free Postgres, NOT Render's
SINOPIA_DB_PATH=sinopia.db
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SINOPIA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
GROQ_API_KEY=your-key-here          # optional; the explain endpoint falls back to a template

# ---- Frontend ----
VITE_API_URL=                       # empty for localhost:8000 in dev; Render URL in production
VITE_GOOGLE_CLIENT_ID=              # same Google client id as the backend

# ---- Landing ----
VITE_COACH_APP_URL=                 # link of the "Open the coach tool" button
