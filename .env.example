# Copy to .env for local development. Never commit real secrets.
SINOPIA_ENV=development
# Production must set SINOPIA_ENV=production and exact HTTPS origins below.
SINOPIA_DB_PATH=sinopia.db
# Production only: use Neon PostgreSQL with sslmode=require and the restricted app role.
# Keep DATABASE_OWNER_URL out of the running API environment; use it only for migrations.
DATABASE_URL=
SINOPIA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
GROQ_API_KEY=

# Required in production for Google sign-in. Registration is open by default.
GOOGLE_CLIENT_ID=
# Email signup uses Resend. Configure only after verifying your sending domain.
RESEND_API_KEY=
SINOPIA_EMAIL_FROM=Sinopia <accounts@your-verified-domain.example>
SINOPIA_EMAIL_APP_URL=https://your-coach-app-domain.example
SINOPIA_EMAIL_TOKEN_SECRET=
# Optional: set comma-separated coach emails ONLY if you want invite-only pilot access.
SINOPIA_TERMS_VERSION=2026-10-14
SINOPIA_PRIVACY_VERSION=2026-10-14

# Production: generate a private 32-byte key and store it only in the host secret manager.
# Format: active-key-id:base64url-key,older-key-id:old-base64url-key (retain old keys during rotation).
SINOPIA_ENCRYPTION_KEYS=

# Production bot protection. Configure the matching public site key in frontend/.env.example.
# Hostnames must exactly match the coach app's deployed hostname and Cloudflare's site-key allowlist.
TURNSTILE_SECRET_KEY=
SINOPIA_TURNSTILE_HOSTNAMES=sinopia-app.vercel.app
# Shared secret between the Vercel /api proxy and the private backend origin (32+ random characters).
SINOPIA_PROXY_SECRET=
# Calendar timezone for server-assigned dates; use an IANA name for the pilot location.
SINOPIA_TIMEZONE=Africa/Lagos

# Retention job: configure only after a data-controller-approved retention period exists.
# CRON_SECRET must be at least 32 random characters; keep it in the API Vercel project only.
CRON_SECRET=
# Integer 1-3650; leave empty to fail closed and perform no scheduled deletion.
SINOPIA_RETENTION_DAYS=
