# Copy to .env for local development. Never commit real secrets.
SINOPIA_ENV=development
# Production must set SINOPIA_ENV=production and exact HTTPS origins below.
SINOPIA_DB_PATH=sinopia.db
# Production only: use Neon PostgreSQL with sslmode=require and the restricted app role.
# Keep DATABASE_OWNER_URL out of the running API environment; use it only for migrations.
DATABASE_URL=
SINOPIA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
SINOPIA_TRUST_PROXY=false
GROQ_API_KEY=

# Required in production for Google sign-in and invite-only beta access.
GOOGLE_CLIENT_ID=
SINOPIA_COACH_ALLOWLIST=coach@example.com
SINOPIA_TERMS_VERSION=2026-10-14
SINOPIA_PRIVACY_VERSION=2026-10-14

# Production: generate a private 32-byte key and store it only in the host secret manager.
# Format: active-key-id:base64url-key,older-key-id:old-base64url-key (retain old keys during rotation).
SINOPIA_ENCRYPTION_KEYS=
