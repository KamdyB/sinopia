# Local FastAPI URL. Production uses the same-origin Vercel proxy at /api.
VITE_API_BASE=http://localhost:8000

# OAuth client ID for the coach sign-in UI (public identifier, not a secret).
VITE_GOOGLE_CLIENT_ID=

# Public landing/legal pages URL for footer and check-in links.
VITE_LEGAL_BASE_URL=http://localhost:5174
# In Vercel production, set this to the deployed landing-site origin, e.g. https://your-landing-domain.example
