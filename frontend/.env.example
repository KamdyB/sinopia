# Local FastAPI URL. Production should use a same-origin /api rewrite.
VITE_API_BASE=http://localhost:8000

# OAuth client ID for the coach sign-in UI (public identifier, not a secret).
VITE_GOOGLE_CLIENT_ID=

# Public landing/legal pages URL for footer and check-in links.
VITE_LEGAL_BASE_URL=http://localhost:5174
