# Local FastAPI URL. Production uses the same-origin Vercel proxy at /api.
VITE_API_BASE=http://localhost:8000

# OAuth client ID for the coach sign-in UI (public identifier, not a secret).
VITE_GOOGLE_CLIENT_ID=

# Public landing/legal pages URL for footer and check-in links.
VITE_LEGAL_BASE_URL=http://localhost:5174
# In Vercel production, set this to the deployed landing-site origin, e.g. https://your-landing-domain.example

# Public Cloudflare Turnstile site key (never put the secret key here).
# Set in the coach-app Vercel project for Production and any Preview environment you test,
# then redeploy. In Cloudflare, allow the exact coach-app hostname (no scheme or path).
VITE_TURNSTILE_SITE_KEY=
# Server-only secret for the /api proxy; do not prefix with VITE_ and never expose it in the browser.
SINOPIA_PROXY_SECRET=
# Server-only URL of the API Vercel project; never expose with a VITE_ prefix.
SINOPIA_BACKEND_URL=https://api.example.com
