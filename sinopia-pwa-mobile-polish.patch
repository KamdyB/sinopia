From 53794c54c5ab3289ea0b544cc278f4ce79391ef0 Mon Sep 17 00:00:00 2001
From: KamdyB <noreply@users.noreply.github.com>
Date: Mon, 19 Oct 2026 00:00:18 +0000
Subject: [PATCH] feat: PWA install support, themed sign-in screens, mobile
 layout polish, proxy fallback to recorded API origin

---
 frontend/api/index.ts                      |   2 +-
 frontend/index.html                        |  14 ++++++--
 frontend/public/icons/apple-touch-icon.png | Bin 0 -> 1191 bytes
 frontend/public/icons/icon-192.png         | Bin 0 -> 1252 bytes
 frontend/public/icons/icon-512.png         | Bin 0 -> 3595 bytes
 frontend/public/icons/maskable-512.png     | Bin 0 -> 3049 bytes
 frontend/public/manifest.webmanifest       |  16 +++++++++
 frontend/public/sw.js                      |  37 +++++++++++++++++++++
 frontend/src/App.tsx                       |   7 ++--
 frontend/src/main.tsx                      |   6 ++++
 frontend/src/theme.css                     |  25 ++++++++++++++
 frontend/vercel.json                       |  28 +++++++++++++++-
 12 files changed, 126 insertions(+), 9 deletions(-)
 create mode 100644 frontend/public/icons/apple-touch-icon.png
 create mode 100644 frontend/public/icons/icon-192.png
 create mode 100644 frontend/public/icons/icon-512.png
 create mode 100644 frontend/public/icons/maskable-512.png
 create mode 100644 frontend/public/manifest.webmanifest
 create mode 100644 frontend/public/sw.js

diff --git a/frontend/api/index.ts b/frontend/api/index.ts
index 88b01e5..e741065 100644
--- a/frontend/api/index.ts
+++ b/frontend/api/index.ts
@@ -5,7 +5,7 @@ declare const process: { env: Record<string, string | undefined> };
 
 export const config = { runtime: "edge" };
 
-const DEFAULT_BACKEND_ORIGIN = "https://sinopia-api.vercel.app";
+const DEFAULT_BACKEND_ORIGIN = "https://sinopia-eight.vercel.app";
 const ALLOWED_METHODS = new Set(["GET", "POST", "DELETE", "OPTIONS"]);
 
 export default async function handler(request: Request): Promise<Response> {
diff --git a/frontend/index.html b/frontend/index.html
index d2377ec..060596f 100644
--- a/frontend/index.html
+++ b/frontend/index.html
@@ -1,13 +1,21 @@
 <!-- frontend/index.html -->
 <!doctype html>
-<html lang="en">
+<html lang="en" data-team="girls">
   <head>
     <meta charset="UTF-8" />
-    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
+    <meta name="theme-color" content="#a3435f" />
+    <meta name="description" content="Workload and check-in monitoring for school and youth coaches." />
+    <meta name="mobile-web-app-capable" content="yes" />
+    <meta name="apple-mobile-web-app-capable" content="yes" />
+    <meta name="apple-mobile-web-app-title" content="Sinopia" />
+    <link rel="manifest" href="/manifest.webmanifest" />
+    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
+    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
     <title>Sinopia</title>
   </head>
   <body>
     <div id="root"></div>
     <script type="module" src="/src/main.tsx"></script>
   </body>
-</html>
\ No newline at end of file
+</html>
